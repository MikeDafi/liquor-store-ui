# Store Configuration
VITE_STORE_ID="home-service-market"

# Optional public canonical origin; defaults to the selected store's URL in data/stores.json.
# Do not use a protected Vercel preview/deployment hostname here.
# VITE_SITE_URL="https://home-service-market.vercel.app"

# Search Console's public HTML verification value, configured only on the matching project.
# GOOGLE_SITE_VERIFICATION="your-verification-value"

# Optional measurement destinations. Leave unset until the owner's property is connected.
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Vercel custom events require a supported plan; disabled unless explicitly enabled.
# VITE_VERCEL_CUSTOM_EVENTS="true"

# Upstash Redis (for product image caching)
# Get these from: https://console.upstash.com/
# 1. Create a free Redis database
# 2. Copy the REST URL and Token
UPSTASH_REDIS_REST_URL="https://YOUR_DATABASE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN_HERE"
